# Copy to .env and adjust. Never commit the real .env.

# --- Paths (defaults shown are used when unset) ---
# MCPFW_HOME=~/.mcp-firewall
MCPFW_SERVERS_FILE=config/servers.example.yaml
MCPFW_POLICIES_FILE=config/policies.example.yaml

# --- Approval behaviour ---
MCPFW_APPROVAL_TIMEOUT_SECONDS=60
MCPFW_MAX_PENDING_REQUESTS=100
MCPFW_MAX_ARGUMENT_BYTES=262144
MCPFW_EXECUTION_TIMEOUT_SECONDS=120

# --- Persistence ---
# Default is SQLite in MCPFW_HOME. For the remote gateway use PostgreSQL:
# MCPFW_DATABASE_URL=postgresql://mcpfw:change-me@localhost:5432/mcpfw
# MCPFW_REDIS_URL=redis://localhost:6379/0

# --- Remote gateway (Claude Web) ---
# Generate tokens with:  mcp-firewall token generate
# Store only the SHA-256 hashes here:  mcp-firewall token hash <token>
# Format: id:role:sha256hex[:tenant]   (comma separated). Roles: viewer, approver, admin
# MCPFW_APPROVER_TOKENS=alice:admin:<sha256>
# Bearer tokens accepted on the MCP endpoint (id:sha256hex, comma separated)
# MCPFW_MCP_CLIENT_TOKENS=claude-web:<sha256>
# Encryption key for arguments at rest (Fernet). If unset: OS keyring, then a key file in MCPFW_HOME.
# MCPFW_ENCRYPTION_KEY=
